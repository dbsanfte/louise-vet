#!/bin/bash
# Install as root-owned /usr/local/sbin/louise-deploy, mode 0755.
# Only trusted main-branch CI may invoke this via the dedicated runner's sudo rule.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
[[ $EUID == 0 && $# == 2 && $1 =~ ^[0-9a-f]{40}$ && $2 =~ ^sha256:[0-9a-f]{64}$ ]] || {
  echo 'Usage: louise-deploy FULL_COMMIT_SHA sha256:IMAGE_DIGEST' >&2
  exit 2
}
revision=$1
image="ghcr.io/dbsanfte/vet-game:$revision@$2"
state=/var/lib/louise-vet
install -d -m 0700 "$state"
exec 9>"$state/deploy.lock"
flock -w 300 9
previous=$(kubectl -n louise-vet get deployment web -o jsonpath='{.spec.template.spec.containers[0].image}')
rollback() {
  echo 'Deployment failed; restoring the preceding image.' >&2
  if [[ $previous != *:bootstrap ]]; then
    kubectl -n louise-vet set image deployment/web "web=$previous"
    kubectl -n louise-vet rollout status deployment/web --timeout=180s
  fi
}
trap 'rollback' ERR
# Update the image and pull policy together, including older Never deployments.
# Kubernetes pulls the published digest from GHCR when it is absent on the node.
kubectl -n louise-vet patch deployment web --type=strategic --patch \
  "{\"spec\":{\"template\":{\"spec\":{\"containers\":[{\"name\":\"web\",\"image\":\"$image\",\"imagePullPolicy\":\"IfNotPresent\"}]}}}}"
kubectl -n louise-vet rollout status deployment/web --timeout=180s
kubectl -n louise-vet wait certificate/louise-vet-tls --for=condition=Ready --timeout=300s
verify_ingress() {
  # Pod readiness can precede Traefik receiving the new endpoints. Retry the
  # entire health/revision check; an old healthy backend must not pass the gate.
  local attempt
  for attempt in {1..10}; do
    if test "$(curl --fail --silent --show-error --connect-timeout 3 --max-time 5 --resolve louise.vet:443:127.0.0.1 https://louise.vet/healthz)" = ok &&
      curl --fail --silent --show-error --connect-timeout 3 --max-time 5 --resolve louise.vet:443:127.0.0.1 https://louise.vet/version.json |
        python3 -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("revision") == sys.argv[1] else 1)' "$revision"; then
      return 0
    fi
    echo "Waiting for HTTPS to serve the expected revision ($attempt/10)." >&2
    if (( attempt < 10 )); then sleep 3; fi
  done
  return 1
}
verify_ingress
trap - ERR
printf '%s\n' "$revision" > "$state/current-revision"
printf '%s\n' "$image" > "$state/current-image"
printf 'Live revision: %s\n' "$revision"
