{
  "name": "Vet Game",
  "dockerComposeFile": [
    "../compose.yaml",
    "compose.yaml",
    "compose.local.yaml"
  ],
  "initializeCommand": ["node", "scripts/prepare-devcontainer.mjs"],
  "service": "dev",
  "runServices": ["dev", "web"],
  "workspaceFolder": "/workspaces/vet-game",
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  "remoteEnv": { "CODEX_HOME": "/home/node/.codex" },
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Game · live development", "onAutoForward": "notify" }
  },
  "postCreateCommand": "sudo chown -R node:node node_modules && npm ci && npx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "openai.chatgpt"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
