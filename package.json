{
  "name": "vet-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test tests/economy.test.ts tests/animations.test.ts tests/clinical.test.ts",
    "check": "npm run format:check && npm run build && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.4",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.185.1"
  }
}
